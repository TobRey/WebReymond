# Konfiguration mit echten Zugangsdaten – niemals ins Repository
public_html/app/config.php

# Die Datenbank des Probelaufs. Sie enthält Testprojekte, Sitzungen und
# Anmeldeversuche und gehört nirgendwo hin ausser auf den eigenen Rechner.
public_html/storage/*.sqlite
public_html/storage/*.sqlite-shm
public_html/storage/*.sqlite-wal

# Laufzeitdaten
public_html/storage/projects/*
public_html/storage/zips/*
public_html/storage/previews/*
public_html/storage/uploads/*
public_html/storage/logs/*
public_html/storage/tmp/*
!public_html/storage/**/.gitkeep

# Frontend-Build
node_modules/
frontend/node_modules/
frontend/.vite/

# Fertige Auslieferung
dist/
*.zip

# System
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
