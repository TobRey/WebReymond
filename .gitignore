# Konfiguration mit echten Zugangsdaten – niemals ins Repository
public_html/app/config.php

# Die Datenbank des Probelaufs. Sie enthält Testprojekte, Sitzungen und
# Anmeldeversuche und gehört nirgendwo hin ausser auf den eigenen Rechner.
public_html/storage/*.sqlite
public_html/storage/db-*.sqlite
public_html/storage/*.sqlite-shm
public_html/storage/*.sqlite-wal

# Laufzeitdaten
public_html/storage/projects/*
public_html/storage/zips/*
public_html/storage/previews/*
public_html/storage/uploads/*
public_html/storage/logs/*
public_html/storage/tmp/*
public_html/storage/documents/*
public_html/storage/backups/*
public_html/storage/fonts/*
# Das installierte Editor-Plugin gehoert der Installation, nicht dem
# Repository - und erst recht nicht dem Auslieferungspaket.
public_html/storage/plugins/*

# Die Regelebene der Frontend-Fixes. Sie entsteht aus der Datenbank neu,
# sobald sie fehlt - im Repository haette sie den Stand eines fremden
# Rechners.
public_html/storage/frontend-fix.css

# Der Merker fuer den Tabellenstand entsteht auf jeder Installation neu.
public_html/storage/schema-version.txt
public_html/storage/schema-version.txt.lock
!public_html/storage/**/.gitkeep

# Frontend-Build
node_modules/
frontend/node_modules/
frontend/.vite/

# Fertige Auslieferung
dist/
*.zip

# System
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Das Protokoll des Probelaufs – Arbeitsspur, kein Quelltext.
tools/probelauf/anfragen.log

# Beim Neubau der Briefvorlage entstehende Dateien.
tools/briefvorlage/node_modules/
tools/briefvorlage/*.docx
tools/briefvorlage/*.pdf
tools/briefvorlage/seite-*.jpg
