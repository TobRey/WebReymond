# WebHeaven – Beispielkonfiguration
#
# Diese Datei ist eine VORLAGE und gehört ins Repository.
# Die echte Datei heisst .env, wird NIE committet und enthält die tatsächlichen Werte.
#
# Anlegen (in WSL/Linux):   cp .env.example .env && chmod 600 .env
#
# Regeln:
#   - Keine echten Schlüssel in dieser Datei.
#   - Für Entwicklung und Produktion getrennte Schlüssel verwenden.
#   - Secrets erscheinen nie im Frontend und nie in Logs.
#
# Hinweis: Die meisten Einträge werden erst in späteren Phasen benötigt.
# Stand Phase 0: nur Platzhalter, noch kein Code, der sie liest.

# --- Grundeinstellungen ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
DEFAULT_LOCALE=de

# --- Datenbank (Phase 3) ---
DATABASE_URL=postgresql://webheaven:CHANGE_ME@localhost:5432/webheaven

# --- Authentifizierung (Phase 4) ---
# Zufallswert erzeugen mit:  openssl rand -base64 48
AUTH_SECRET=CHANGE_ME
SESSION_COOKIE_NAME=webheaven_session

# --- E-Mail-Versand für System-Mails wie Passwort-Reset (Phase 4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.test

# --- Hosting-Layer / Provisioning (Phase 9) ---
HESTIA_HOST=127.0.0.1
HESTIA_API_USER=
HESTIA_API_KEY=
PROVISIONING_ENABLED=false

# --- Domain-Registrar (Phase 10) ---
# Erst die Testumgebung (OT&E) verwenden, nie direkt die Produktivumgebung.
DOMAIN_PROVIDER=inwx
DOMAIN_PROVIDER_USER=
DOMAIN_PROVIDER_PASSWORD=
DOMAIN_PROVIDER_SANDBOX=true

# --- DNS-Anbieter (Phase 10) ---
DNS_PROVIDER=hetzner
DNS_PROVIDER_TOKEN=

# --- Zahlungen (Phase 11) ---
# Nur Testschlüssel (sk_test_/pk_test_) verwenden, bis Phase 22 abgeschlossen ist.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- E-Mail-Hosting für Kunden (Phase 19) ---
MAIL_PROVIDER=
MAIL_PROVIDER_API_KEY=

# --- Backups (Phase 14) ---
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
