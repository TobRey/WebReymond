# Dieser Ordner enthaelt private Daten und ist nicht oeffentlich.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

# Falls die Regeln oben nicht greifen: hier laeuft nichts.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php5 .php7 .php8
