# ------------------------------------------------------------------
# Iang's Thai Food — Servereinstellungen
# ------------------------------------------------------------------

# Standardzeichensatz
AddDefaultCharset UTF-8

# Keine Verzeichnisauflistungen
Options -Indexes

# Startseite
DirectoryIndex index.html index.php

# Eigene Fehlerseite
ErrorDocument 404 /404.html

# --- Kurze Adressen -----------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^doc/?$ doc.html [L]
    RewriteRule ^support/?$ support.php [L]
    RewriteRule ^statistik/?$ statistik.php [L]
</IfModule>

# --- Sicherheitskopfzeilen ----------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://web-atze.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://web-atze.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"

    # Diese Seiten gehören nicht in Suchmaschinen
    <FilesMatch "^(doc\.html|support\.php|statistik\.php|formular\.php|zaehler\.php|wochenbericht\.php)$">
        Header always set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

# --- Vertrauliches ------------------------------------------------
<FilesMatch "^(config\.php|\.env|.*\.json|.*\.log)$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Kompression und Zwischenspeicher ------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
