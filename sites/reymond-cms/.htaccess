# Reymond CMS – Apache-Einstellungen (GoDaddy, cPanel und die meisten Hoster)

# --- Saubere Adressen -------------------------------------------------------
# Alles, was keine echte Datei ist, geht an index.php.
<IfModule mod_rewrite.c>
	RewriteEngine On

	# Liegt das CMS in einem Unterordner, hier den Ordner eintragen:
	# RewriteBase /unterordner

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.php [L]
</IfModule>

# --- Daten abschirmen -------------------------------------------------------
# Inhalte, Zugangsdaten und Sicherungen gehören niemandem ausser dem Server.
RedirectMatch 404 ^/data/
RedirectMatch 404 ^/app/

<FilesMatch "\.(json|log|md)$">
	Require all denied
</FilesMatch>

# Ausnahme: nichts im Web-Wurzelverzeichnis braucht diese Dateien.

# --- Kleinigkeiten ----------------------------------------------------------
<IfModule mod_headers.c>
	Header set X-Content-Type-Options "nosniff"
	Header set X-Frame-Options "SAMEORIGIN"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 7 days"
	ExpiresByType application/javascript "access plus 7 days"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType audio/mpeg "access plus 30 days"
</IfModule>

# Verzeichnisse nicht auflisten
Options -Indexes

# Fehlerseite
ErrorDocument 404 /index.php
