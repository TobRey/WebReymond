# Uploads werden ausschliesslich ueber den PHP-Medien-Endpunkt ausgeliefert.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
# Zusaetzlicher Schutz: niemals PHP ausfuehren
php_flag engine off
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
AddType text/plain .php .phtml .phar .cgi .pl .py
