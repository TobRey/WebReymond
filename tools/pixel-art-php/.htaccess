# Die Einstellungen mit dem Schlüssel gehen niemanden etwas an.
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Beim Aufruf des Ordners die Seite zeigen.
DirectoryIndex index.html
