# Quarter Clown – lokale Konfiguration
# Kopiere diese Datei nach ".env" und trage deine Werte ein. ".env" wird nie committet.

# --- Discord (Developer Portal → Applications → Bot → Reset Token) ---
DISCORD_BOT_TOKEN=
# Optional: Server-ID für sofort sichtbare Slash-Commands (sonst globale Synchronisierung)
DISCORD_GUILD_ID=
# Rolle, die zusätzlich zu "Server verwalten" /quarter setup und /quarter stop darf
QC_ADMIN_ROLE=Quarter Clown Admin

# --- Anthropic Claude API (leer lassen = lokaler Modus mit Caption-Vorlagen) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Denkaufwand: low | medium | high (low = schnell und günstig, reicht für Captions)
ANTHROPIC_EFFORT=low
# auto = Claude wenn Key vorhanden, sonst lokal | claude | local
QC_CAPTION_MODE=auto
# brainrot = Brainrot Deutsch (Standard) | gsw = Brainrot Schwiizerdütsch | de = klassisch trocken
QC_CAPTION_STYLE=brainrot

# --- Aufnahme ---
# window = Discord-Fenster direkt | obs = Screenshot einer OBS-Quelle
QC_CAPTURE_SOURCE=window
# Fenstertitel, der in der App vorausgewählt wird
QC_WINDOW_TITLE=Discord
QC_CAPTURE_FPS=4
# Discord-Ton per Loopback (1/0). Teil des Ausgabegerät-Namens, leer = Standardgerät
QC_AUDIO=1
QC_AUDIO_DEVICE=
# Eigenes Mikrofon dazumischen (auch in der App umschaltbar)
QC_MIC=0
# Optional: kurze Ausschnitte lokal transkribieren (pip install -r requirements-extra.txt)
QC_TRANSCRIBE=0
QC_WHISPER_MODEL=small

# --- OBS (nur bei QC_CAPTURE_SOURCE=obs; OBS → Werkzeuge → WebSocket-Servereinstellungen) ---
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
OBS_SOURCE=Discord

# --- Testmodus (start-test.bat) ---
# Testkanal-ID als Fallback; empfohlen: /quarter setup ... testkanal:#kanal
QC_TEST_CHANNEL_ID=
# Optional: eigenes Beispielvideo oder Bilderordner statt synthetischem Call
QC_SAMPLE_PATH=

# Gepostete Memes zusätzlich lokal in output/posted speichern (1/0)
QC_SAVE_POSTED=0
