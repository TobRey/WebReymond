# Server-Konfiguration – nach ".env" kopieren. ".env" nie committen.

# Domain, die auf diesen Server zeigt (DNS A-Record), z. B. quarterclown.deinedomain.ch
QC_DOMAIN=

# Token des zentralen Bots (Discord Developer Portal → Bot → Reset Token)
DISCORD_BOT_TOKEN=

# Öffentliche Adresse (gleich wie QC_DOMAIN, mit https://)
QC_PUBLIC_URL=https://

# Download-Link der Windows-App (Standard: neuestes Release im öffentlichen Repo)
QC_DOWNLOAD_URL=https://github.com/TobRey/quarter-clown/releases/latest/download/QuarterClown-Setup.exe
