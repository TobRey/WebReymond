# AI Groove – API-Verzeichnis
Options -Indexes -MultiViews

# Nur ai-proxy.php ist oeffentlich erreichbar. config.php wird ausschliesslich
# per require eingebunden und darf nicht direkt aufgerufen werden.
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<IfModule mod_headers.c>
    Header always set Cache-Control "no-store"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
