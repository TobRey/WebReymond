# SwipeGroove – Apache-Konfiguration (funktioniert in Domain-Root und Unterordnern)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bestehende Dateien (Assets, Uploads) direkt ausliefern,
    # alles andere an den Front-Controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Geschützte Verzeichnisse und Dateien
<IfModule mod_rewrite.c>
    RewriteRule ^(app|config|storage|migrations|cron|lang|tests|frontend|vendor)(/|$) - [F,L]
    RewriteRule ^(composer\.(json|lock)|\.env.*|.*\.sql|.*\.md|.*\.bak|.*\.zip)$ - [F,L]
</IfModule>

<FilesMatch "^(composer\.json|composer\.lock|\.env|.*\.sql|.*\.bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Sicherheits-Header
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Schriften (manche Hoster kennen den Typ nicht)
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# Caching für gebaute Assets (Dateinamen enthalten Hashes)
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|webp|ico)$">
        ExpiresDefault "access plus 30 days"
    </FilesMatch>
</IfModule>
