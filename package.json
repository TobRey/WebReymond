{
  "name": "webheaven",
  "version": "0.1.0",
  "private": true,
  "description": "WebHeaven \u2013 Webhosting-Plattform (Monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./apps/*\" dev",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test && pnpm test:game",
    "test:game": "node --test \"games/heavenclimb/test/*.test.mjs\"",
    "game:zip": "node games/heavenclimb/pack.mjs",
    "game:dev": "php -S 127.0.0.1:8137 -t games/heavenclimb/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "clean": "pnpm -r exec rm -rf dist .next node_modules/.cache",
    "db:migrate": "pnpm --filter @webheaven/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @webheaven/api exec prisma migrate deploy",
    "db:generate": "pnpm --filter @webheaven/api exec prisma generate",
    "db:studio": "pnpm --filter @webheaven/api exec prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
